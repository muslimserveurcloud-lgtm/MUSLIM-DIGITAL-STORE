# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/muslim_digital_store"

# --- Auth (NextAuth) ------------------------------------------------------
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Payments (Stripe shown as the default provider; swap/add others in
#     src/lib/services/payment-service.ts) --------------------------------
PAYMENT_SECRET_KEY="sk_test_xxx"
PAYMENT_PUBLISHABLE_KEY="pk_test_xxx"
PAYMENT_WEBHOOK_SECRET="whsec_xxx"

# --- Private file storage (S3-compatible: AWS S3, Backblaze, R2, etc.) ---
STORAGE_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
STORAGE_REGION="eu-west-1"
STORAGE_BUCKET="muslim-digital-store-private"
STORAGE_ACCESS_KEY="xxx"
STORAGE_SECRET_KEY="xxx"

# --- Email (Resend shown as default; swap in src/lib/email) --------------
EMAIL_API_KEY="re_xxx"
EMAIL_FROM="MUSLIM DIGITAL STORE <no-reply@muslimdigitalstore.com>"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MUSLIM DIGITAL STORE"

# --- Download link security ------------------------------------------------
DOWNLOAD_LINK_EXPIRY_MINUTES=60
DOWNLOAD_MAX_ATTEMPTS=5
